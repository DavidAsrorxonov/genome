{
  "name": "@genomejs/react",
  "version": "0.1.1",
  "description": "React bindings for @genomejs/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidAsrorxonov/genome.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/DavidAsrorxonov/genome/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/DavidAsrorxonov/genome/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --tsconfig tsconfig.build.json && rm -f dist/index.test.d.ts dist/index.test.d.ts.map"
  },
  "peerDependencies": {
    "@genomejs/core": "*",
    "react": ">=18"
  },
  "devDependencies": {
    "@genomejs/core": "*",
    "@types/react": "^18.3.5",
    "react": "^18.3.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
