{
  "name": "@genome/vue",
  "version": "0.1.0",
  "description": "Vue bindings for @genome/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidAsrorxonov/genome.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/DavidAsrorxonov/genome/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/DavidAsrorxonov/genome/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --tsconfig tsconfig.build.json"
  },
  "peerDependencies": {
    "@genome/core": "*",
    "vue": ">=3"
  },
  "devDependencies": {
    "@genome/core": "*",
    "vue": "^3.4.38"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
