{
  "name": "@genome/core",
  "version": "0.1.0",
  "description": "Reactive design token compiler — dependency-graph resolver, contrast locking, fluid typography, and browser environment hooks.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidAsrorxonov/genome.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/DavidAsrorxonov/genome/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/DavidAsrorxonov/genome/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --tsconfig tsconfig.build.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
